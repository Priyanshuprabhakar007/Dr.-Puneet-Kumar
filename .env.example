# ==============================================================================
# Production Environment Variables for Dr. Puneet Kumar Clinic Web Application
# ==============================================================================

# Server & Canonical Origin
NODE_ENV=production
PORT=3000
# Canonical HTTPS origin only (e.g. https://drpuneetkumar.com). No subpaths, queries, or trailing slash.
PUBLIC_SITE_URL=https://your-production-domain.com

# Admin Authentication
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_SESSION_SECRET=replace_with_a_long_random_session_secret_at_least_32_characters

# Firebase Cloud Firestore Admin Credentials
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
# Private key from GCP Service Account. If multiline in hosting env, retain \n or literal newlines in quotes:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_ID=(default)

# Media Storage Provider ('supabase' for durable Vercel storage, 'local' for persistent VPS/server filesystem, or 'firebase' for Firebase Cloud Storage)
MEDIA_STORAGE_PROVIDER=supabase

# Required when MEDIA_STORAGE_PROVIDER=supabase (SERVER ONLY - never expose to client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_server_secret_key
SUPABASE_STORAGE_BUCKET=website-media

# Optional: Required only if MEDIA_STORAGE_PROVIDER=firebase (e.g., your-project-id.firebasestorage.app)
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
