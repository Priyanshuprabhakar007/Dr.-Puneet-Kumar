rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return false; // Privileged database operations are handled securely via Firebase Admin SDK on the Express backend
    }

    // Health check collection
    match /test/{docId} {
      allow read: if true;
    }

    // Direct client access to sensitive collections is denied; all operations route through Express API via Firebase Admin SDK
    match /appointments/{docId} {
      allow read, write: if false;
    }

    match /contactLeads/{docId} {
      allow read, write: if false;
    }

    match /siteContent/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /mediaAssets/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
